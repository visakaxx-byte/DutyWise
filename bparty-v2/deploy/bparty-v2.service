[Unit]
Description=BParty V2 clearance service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/bparty-v2
EnvironmentFile=/opt/bparty-v2/.env
ExecStart=/opt/bparty-v2/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8002
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
